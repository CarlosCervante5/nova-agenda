generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  domain        String?   @unique
  email         String?
  phone         String?
  address       String?
  logo          String?
  primaryColor  String    @default("#2dd4bf")
  headlineColor String    @default("#0f172a")
  bodyTextColor String    @default("#334155")
  labelTextColor String   @default("#64748b")
  surfaceBgColor String   @default("#f8fafc")
  tagline       String?
  about         String?
  coverImage    String?
  instagram     String?
  facebook      String?
  whatsappPhone String?
  linktreeUrl   String?
  // Links personalizados para la pagina linktree (JSON array de {title, url})
  customLinks   String    @default("[]")
  websiteEnabled Boolean  @default(true)
  // Minutos de espacio entre citas: 5, 10, 15 o 20
  slotGapMinutes Int      @default(10)
  // Formulario público de reservas
  bookingFormEnabled   Boolean @default(true)
  bookingRequirePhone  Boolean @default(false)
  bookingRequireEmail  Boolean @default(false)
  bookingShowNotes     Boolean @default(true)
  bookingIntroText     String?
  bookingSuccessText   String?
  bookingConfirmAuto   Boolean @default(false)
  isActive      Boolean   @default(true)
  plan          String    @default("FREE")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // Cuenta Stripe propia del negocio para cobrar a sus clientes
  // Modo activo: "test" o "live" (cambiar con el toggle en Configuración de Cobros)
  stripeMode            String  @default("test")
  stripeTestSecretKey   String?
  stripeTestPublishableKey String?
  stripeTestWebhookSecret  String?
  stripeLiveSecretKey   String?
  stripeLivePublishableKey String?
  stripeLiveWebhookSecret  String?
  // Addons contratados (JSON array, ej: ["WHATSAPP_AI","POS"])
  addons        String    @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users         User[]
  services      Service[]
  serviceCategories ServiceCategory[]
  bookings      Booking[]
  staffMembers  StaffMember[]
  workingHours  WorkingHours[]
  whatsappConfig WhatsAppConfig?
  whatsappLogs   WhatsAppLog[]
  loyaltyProgram LoyaltyProgram?
  membershipPlans MembershipPlan[]
  membershipPurchases MembershipPurchase[]
  posProducts PosProduct[]
  posSales    PosSale[]

  @@map("clients")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("CLIENT")
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String?

  @@map("users")
}

model ServiceCategory {
  id            String    @id @default(cuid())
  name          String
  description   String?
  color         String    @default("#2dd4bf")
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  parent        ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  parentId      String?
  children      ServiceCategory[] @relation("CategoryTree")
  services      Service[]

  @@map("service_categories")
}

model Service {
  id            String    @id @default(cuid())
  name          String
  description   String?
  duration      Int
  price         Float?
  isActive      Boolean   @default(true)
  color         String    @default("#2dd4bf")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  category      ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    String?
  bookings      Booking[]
  staffServices StaffService[]
  useCustomHours Boolean @default(false)
  workingHours  ServiceWorkingHours[]

  @@map("services")
}

model ServiceWorkingHours {
  id        String  @id @default(cuid())
  dayOfWeek Int
  openTime  String
  closeTime String
  isOpen    Boolean @default(true)

  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String

  @@unique([serviceId, dayOfWeek])
  @@map("service_working_hours")
}

model StaffMember {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  title         String?   // cargo: Estilista, Terapeuta, etc.
  bio           String?
  color         String    @default("#2dd4bf")
  avatarUrl     String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  services      StaffService[]
  bookings      Booking[]

  @@map("staff_members")
}

model StaffService {
  id            String      @id @default(cuid())
  staff         StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId       String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId     String

  @@unique([staffId, serviceId])
  @@map("staff_services")
}

model Booking {
  id            String    @id @default(cuid())
  customerName  String
  customerEmail String?
  customerPhone String?
  date          DateTime
  startTime     String
  endTime       String
  status        String    @default("PENDING")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId     String
  staff         StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId       String?
  loyaltyStamp  LoyaltyStamp?

  @@map("bookings")
}

model WorkingHours {
  id            String    @id @default(cuid())
  dayOfWeek     Int
  openTime      String
  closeTime     String
  isOpen        Boolean   @default(true)

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String

  @@unique([clientId, dayOfWeek])
  @@map("working_hours")
}

model WhatsAppConfig {
  id              String   @id @default(cuid())
  clientId        String   @unique
  phoneNumberId   String
  apiKey          String
  instanceId      String?
  webhookToken    String?
  isOpenAIEnabled Boolean  @default(true)
  aiPersonality   String   @default("Eres un asistente amable y profesional de un negocio de belleza. Tu objetivo es ayudar a los clientes con información y reservar citas.")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("whatsapp_config")
}

model WhatsAppLog {
  id          String   @id @default(cuid())
  clientId    String
  phoneNumber String
  direction   String
  message     String
  intent      String?
  bookingId   String?
  metadata    String?
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("whatsapp_logs")
}

model LoyaltyProgram {
  id            String    @id @default(cuid())
  clientId      String    @unique
  name          String
  description   String?
  stampsToReward Int      @default(10)
  isActive      Boolean   @default(false)
  stampIcon     String    @default("local_fire_department")
  stampColor    String    @default("#2dd4bf")
  backgroundColor String  @default("#ffffff")
  textColor     String    @default("#191c1e")
  enableWhatsApp Boolean  @default(false)
  welcomeMessage String?  @default("¡Bienvenido al programa de fidelidad! Recibirás un sello por cada visita.")
  rewardMessage  String?  @default("¡Felicitaciones! Has completado tu tarjeta y ganado una recompensa.")
  // Card generation options
  cardModes     String    @default("QR") // QR, WALLET, IMAGE, WHATSAPP, or comma-separated
  walletPassTypeIdentifier String? // Apple Wallet pass type ID
  walletTeamIdentifier   String? // Apple Wallet team ID
  walletOrganizationName String? // Apple Wallet organization name
  cardTemplateUrl String? // URL for custom card image template
  cardDesign    String? // JSON: estilo, textos, forma de sello, columnas, logo
  qrSecret      String? // Secret for QR code signing
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rewards       LoyaltyReward[]
  cards         LoyaltyCard[]

  @@map("loyalty_programs")
}

model LoyaltyReward {
  id            String    @id @default(cuid())
  programId     String
  name          String
  description   String?
  stampsRequired Int
  rewardType    String    @default("SERVICE_DISCOUNT") // SERVICE_DISCOUNT, FREE_SERVICE, PERCENTAGE_DISCOUNT, FIXED_AMOUNT, CUSTOM
  value         Float     // discount amount, percentage, or service ID reference
  serviceId     String?   // for FREE_SERVICE type
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  program       LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("loyalty_rewards")
}

model LoyaltyCard {
  id            String    @id @default(cuid())
  programId     String
  customerName  String
  customerEmail String?
  customerPhone String?
  qrCode        String?   @unique // Unique QR code for this card
  walletPassId  String?   // Apple/Google Wallet pass ID
  cardImageUrl  String?   // Generated card image URL
  stampsEarned  Int       @default(0)
  stampsRedeemed Int      @default(0)
  lastVisitAt   DateTime?
  completedAt   DateTime?
  isCompleted   Boolean   @default(false)
  metadata      String?   // JSON for extra data
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  program       LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  stamps        LoyaltyStamp[]

  @@unique([programId, customerPhone])
  @@unique([programId, customerEmail])
  @@map("loyalty_cards")
}

model LoyaltyStamp {
  id            String    @id @default(cuid())
  cardId        String
  bookingId     String?   @unique
  serviceId     String?
  stampsGiven   Int       @default(1)
  note          String?
  createdAt     DateTime  @default(now())

  card          LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("loyalty_stamps")
}

model MembershipPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String   @default("mxn")
  interval    String   @default("month")
  benefits    String   @default("[]")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  purchases   MembershipPurchase[]

  @@map("membership_plans")
}

model MembershipPurchase {
  id                      String    @id @default(cuid())
  customerName            String
  customerEmail           String
  customerPhone           String?
  status                  String    @default("PENDING")
  stripeCheckoutSessionId String?   @unique
  stripeSubscriptionId    String?
  stripeCustomerId        String?
  currentPeriodEnd        DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  plan        MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId      String

  @@index([clientId, status])
  @@map("membership_purchases")
}

model PosProduct {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  sku         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String

  @@map("pos_products")
}

model PosSale {
  id             String    @id @default(cuid())
  customerName   String?
  customerPhone  String?
  subtotal       Float
  discount       Float     @default(0)
  total          Float
  paymentMethod  String
  status         String    @default("COMPLETED")
  notes          String?
  receivedAmount Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  soldById       String?
  items          PosSaleItem[]

  @@index([clientId, createdAt])
  @@map("pos_sales")
}

model PosSaleItem {
  id         String  @id @default(cuid())
  kind       String
  name       String
  quantity   Int     @default(1)
  unitPrice  Float
  total      Float
  serviceId  String?
  productId  String?

  sale       PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId     String

  @@map("pos_sale_items")
}

model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String
  label       String?
  updatedAt   DateTime @updatedAt

  @@map("platform_config")
}
